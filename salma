*{
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body{
    background: #01263b;
    color: white;
    text-align: center;
}


header{
    padding: 40px 20px;
}

header h1{
    font-size: 55px;
    font-weight: bold;
}

header p{
    margin-top: 15px;
    font-size: 22px;
    color: #d9d9d9;
}


.card{
    width: 85%;
    margin: auto;
    background: #020228;
    border-radius: 25px;
    padding: 40px 30px;
    box-shadow: 0 0 20px #00bfff;
    border: 2px solid #0ff;
}

.doctor-image img{
    width: 260px;
    border-radius: 20px;
    border: 4px solid #666;
    box-shadow: 0 0 15px #00bfff;
}

.card h2{
    margin-top: 30px;
    font-size: 50px;
    color: #00bfff;
}

.description{
    margin-top: 25px;
    font-size: 28px;
    line-height: 1.7;
    padding: 0 20px;
}


button{
    margin-top: 35px;
    padding: 18px 50px;
    border: none;
    border-radius: 40px;
    background: #004d66;
    color: white;
    font-size: 28px;
    cursor: pointer;
    box-shadow: 0 0 15px #00bfff;
    transition: 0.3s;
}

button:hover{
    background: #0088aa;
    transform: scale(1.05);
}


footer{
    margin-top: 50px;
    padding: 30px;
    background: #02344f;
    font-size: 24px;
}

footer p{
    margin: 15px 0;
}

footer i{
    margin-right: 10px;
}

